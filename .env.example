# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used for the sign-up confirmation link when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications (optional locally: without RESEND_API_KEY emails are only logged)
RESEND_API_KEY=
EMAIL_FROM=WorkNest <onboarding@resend.dev>
# Shared secret for /api/cron/* and the notify_* DB functions.
# Store its SHA-256 in app_secrets (see db/schema.sql) and set the same value in Vercel.
CRON_SECRET=
